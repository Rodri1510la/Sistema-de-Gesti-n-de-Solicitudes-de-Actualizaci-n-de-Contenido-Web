# Supabase Transaction Pooler (port 6543) and the restricted sgsacw_app role.
DATABASE_URL="postgresql://sgsacw_app.<PROJECT_REF>:<APP_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Supabase Session Pooler (port 5432) for Prisma migrations; keep this privileged URL private.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# Generate a unique random value locally; keep it private.
JWT_SECRET="replace-with-a-random-secret"
